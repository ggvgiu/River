#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE 9, 1

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_RIVER       ICON         "River.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_RIVER MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Reset game\tF1",       IDM_RESET
        MENUITEM "&Two players\tF2",      IDM_SELECT
        MENUITEM "&Pause\tF3",            IDM_PAUSE
        MENUITEM SEPARATOR
        MENUITEM "Player &1 expert missiles\tF4", IDM_DIFFICULTY1
        MENUITEM "Player &2 expert missiles\tF5", IDM_DIFFICULTY2
        MENUITEM "&Sound\tF6",            IDM_SOUND
        MENUITEM "&Black and white\tF7",  IDM_COLOR
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Controls\tF10",       IDM_CONTROLS
        MENUITEM "&About ...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_RIVER ACCELERATORS
BEGIN
    VK_F1,          IDM_RESET,              VIRTKEY
    VK_F2,          IDM_SELECT,             VIRTKEY
    VK_F3,          IDM_PAUSE,              VIRTKEY
    VK_F4,          IDM_DIFFICULTY1,        VIRTKEY
    VK_F5,          IDM_DIFFICULTY2,        VIRTKEY
    VK_F6,          IDM_SOUND,              VIRTKEY
    VK_F7,          IDM_COLOR,              VIRTKEY
    VK_F10,         IDM_CONTROLS,           VIRTKEY
    "?",            IDM_ABOUT,              ASCII, ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About River"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_RIVER,IDC_STATIC,14,14,21,20
    LTEXT           "River, Version 0.1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Native River Raid adaptation",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

